# --- Monad Buy Bot configuration -------------------------------------------
# Copy this file to .env and fill in your values.
# Only TELEGRAM_TOKEN is strictly required; everything else has defaults.

# Telegram bot token from @BotFather (REQUIRED)
TELEGRAM_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Monad RPC endpoint (mainnet default: https://rpc.monad.xyz, chain ID 143)
# Monad testnet: https://testnet-rpc.monad.xyz (chain ID 10143)
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_CHAIN_ID=143

# SQLite database path
DB_PATH=data/bot.db

# Block polling: every POLL_INTERVAL seconds, scan BLOCKS_PER_POLL blocks
POLL_INTERVAL=4.0
BLOCKS_PER_POLL=50

# Manual override for the MON price in USD. 0.0 = automatic: the bot reads
# the on-chain WMON/USDC pair on Monad and caches it (see MON_PRICE_REFRESH_SEC).
MON_USD_PRICE=0.0

# Seconds between automatic MON/USD price refreshes (auto mode only)
MON_PRICE_REFRESH_SEC=300

# Explorer base URL used for [Tx] and [Chart] buttons
EXPLORER_URL=https://monadvision.com

# [Buy] button URL template; {token} is replaced by the token address.
# Examples:
#   https://nad.fun/token/{token}
#   https://pancakeswap.finance/swap?outputCurrency={token}
BUY_URL_TEMPLATE=https://nad.fun/token/{token}

# Optional nad.fun lens/factory contract address (leave empty if unused)
NAD_FUN_LENS=

# Extra DEX quote tokens beyond the built-ins (WMON, USDC, USDT0, WETH).
# CSV of "SYMBOL:0xaddress" entries. Symbols containing "USD" are treated
# as stablecoins (6 decimals, converted via MON_USD_PRICE), symbols
# containing "MON" as native MON wrappers; anything else is unpriced.
# Example:
# QUOTE_TOKENS=AUSD:0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a
QUOTE_TOKENS=
